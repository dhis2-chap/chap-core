# PostgreSQL (Docker Compose)
POSTGRES_USER=chap
POSTGRES_PASSWORD=chap
POSTGRES_DB=chap_core

# Valkey/Redis. Leave unset for compose and host tests: their valkey has no
# password and rejects AUTH.
# REDIS_PASSWORD=

# API authentication (optional). Unset means no authentication.
# Generate with `openssl rand -hex 32`; use at least 32 characters.
# CHAP_API_TOKEN=
# Shared secret for chapkit service registration (optional, separate from CHAP_API_TOKEN).
# SERVICEKIT_REGISTRATION_KEY=

# Host address the API port is published on. The default only accepts connections from
# this machine. Set the host's private IP when DHIS2 runs on another host or VM; localhost:8000
# then stops answering. Avoid 0.0.0.0 on servers: Docker-published ports bypass ufw on Linux.
# CHAP_BIND_ADDRESS=127.0.0.1

# Number of API worker processes. Each answers one request at a time, and a heavy request
# (a plot or a large dataset) can use several GB, so size it by memory as well as cores.
# CHAP_API_WORKERS=1

# Image tag for compose.ghcr.yml. Set a release tag (e.g. v1.2.3) to pin a version.
# CHAP_IMAGE_TAG=

# Overrides the URL composed from POSTGRES_*. Needed for a non-URL-safe password.
# CHAP_DATABASE_URL=
